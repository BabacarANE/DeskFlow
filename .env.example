# Copy to .env (git-ignored) and adjust. Development-only values; never commit real secrets.
# Passwords are embedded in an amqp:// URI: use only URL-safe characters (no @ / : ? #).
POSTGRES_DB=deskflow
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=deskflow
RABBITMQ_PASSWORD=change-me

# Host ports
WEB_PORT=8080
API_PORT=5148
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025
POSTGRES_PORT=5432

# API (phase 1)
# JWT signing key: 32+ characters, random. Generate e.g. with: openssl rand -base64 48
JWT_KEY=change-me-32-characters-minimum-xxxxxxxx
# Enables /auth/demo, the demo seeder and the demo banner
DEMO_ENABLED=true
# First platform SuperAdmin (signs in with Google/GitHub using this verified e-mail)
SUPERADMIN_EMAIL=
PUBLIC_BASE_URL=http://localhost:8080
SMTP_FROM=DeskFlow <no-reply@deskflow.local>
# OAuth credentials: see docs/setup-oauth.md (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
