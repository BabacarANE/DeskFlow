# Copy to .env (git-ignored) and adjust. Development-only values; never commit real secrets.
# Passwords are embedded in an amqp:// URI: use only URL-safe characters (no @ / : ? #).
POSTGRES_DB=deskflow
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=deskflow
RABBITMQ_PASSWORD=change-me

# Host ports
WEB_PORT=8080
API_PORT=5148
RABBITMQ_MANAGEMENT_PORT=15672
MAILPIT_UI_PORT=8025
POSTGRES_PORT=5432

# API (phase 1)
# REQUIRED. JWT signing key: 32+ random characters, never reuse an example value. Generate with: openssl rand -base64 48
JWT_KEY=
# Enables /auth/demo, the demo seeder and the demo banner
DEMO_ENABLED=true
# First platform SuperAdmin (signs in with Google/GitHub using this verified e-mail)
SUPERADMIN_EMAIL=
PUBLIC_BASE_URL=http://localhost:8080
SMTP_FROM=DeskFlow <no-reply@deskflow.local>
# Requests per minute and per IP allowed on the /auth endpoints (development compose only; raised by the CI E2E job)
AUTH_RATE_LIMIT=30
# OAuth credentials: see docs/setup-oauth.md (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Messaging demo: name a consumer (e.g. email-ack) to force retries then the DLQ. Empty = off.
MESSAGING_FAIL_CONSUMER=

# Production only (docker-compose.prod.yml, docs/deploy.md); ignored by the development compose file.
# Public host name (DNS record pointing to the server) and GHCR owner (lowercase GitHub user or organization)
DOMAIN=
GHCR_OWNER=
# Image tag to run (the deploy workflow sets sha-xxxxxxx; latest = last v* release tag)
IMAGE_TAG=latest
# Real SMTP server. Left commented, the "mailpit" compose profile catches the e-mails (demo without provider).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
