{
  "openapi": "3.0.3",
  "info": {
    "title": "DeskFlow API",
    "version": "0.2.0-phase2",
    "description": "Contrat des phases 1 (identité, multi-entreprise) et 2 (tickets), SPEC sections 4, 5, 6, 9. Gelé par l'orchestrateur : tout changement passe par lui. Enums en chaînes, JSON camelCase, erreurs ProblemDetails (RFC 7807), validation 422, ressource d'une autre entreprise = 404."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "me"
    },
    {
      "name": "tenants"
    },
    {
      "name": "users"
    },
    {
      "name": "invitations"
    },
    {
      "name": "categories"
    },
    {
      "name": "tickets"
    },
    {
      "name": "assignees"
    }
  ],
  "paths": {
    "/auth/external/{provider}": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "startExternalLogin",
        "security": [],
        "summary": "Démarre la connexion OAuth (redirection 302 vers le fournisseur)",
        "description": "Au retour du fournisseur, l'API pose le cookie refresh (HttpOnly, Secure, SameSite=Lax) et redirige vers /auth/callback du front. En cas d'échec, redirection vers /auth/callback?error=<code> avec code parmi : invitation_required, invitation_invalid, email_mismatch, email_not_verified, account_disabled, tenant_suspended, provider_error (refus ou échec côté fournisseur).",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Provider"
            }
          },
          {
            "name": "invitation",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Jeton d'invitation en clair"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirection vers le fournisseur"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "refreshToken",
        "security": [
          {
            "refreshCookie": []
          }
        ],
        "summary": "Renouvelle le refresh token (rotation) et renvoie un access token",
        "responses": {
          "200": {
            "description": "Access token JWT de 15 minutes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Révoque le refresh token et supprime le cookie",
        "responses": {
          "204": {
            "description": "Déconnecté"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/demo": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "demoLogin",
        "security": [],
        "summary": "Connexion avec un compte de démo (existe seulement si Demo:Enabled=true, sinon 404)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token ; cookie refresh posé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
