    },
    "/tickets": {
      "get": {
        "tags": [
          "tickets"
        ],
        "operationId": "listTickets",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Requester : ses tickets ; Agent et TenantAdmin : tous ceux de l'entreprise. Filtres, tri, pagination.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TicketStatus"
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/TicketPriority"
            }
          },
          {
            "name": "assigneeId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Ignoré pour un Requester"
          },
          {
            "name": "unassigned",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "true : tickets sans assigné (prioritaire sur assigneeId)"
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Recherche simple, insensible à la casse, dans le titre ou le numéro"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "updatedAt",
                "priority",
                "number"
              ],
              "default": "createdAt"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/pageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "tags": [
          "tickets"
        ],
        "operationId": "createTicket",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Requester, Agent ou TenantAdmin : crée un ticket (statut New, numéro séquentiel par entreprise, échéances SLA calculées d'après la priorité). Le demandeur est l'utilisateur courant. Le SuperAdmin reçoit 403.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicketRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/tickets/{id}": {
      "get": {
        "tags": [
          "tickets"
        ],
        "operationId": "getTicket",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Détail avec commentaires (les commentaires internes sont omis pour un Requester). Un Requester n'accède qu'aux siens ; un autre ticket ou une autre entreprise donne 404.",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "patch": {
        "tags": [
          "tickets"
        ],
        "operationId": "updateTicket",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Agent/TenantAdmin : statut, priorité, assignation, catégorie. Les champs absents sont inchangés ; assigneeId et categoryId à null les retirent. rowVersion obligatoire. Transitions autorisées : New→Open, Open→Pending, Pending→Open, Open→Resolved, Resolved→Open, Resolved→Closed ; toute autre donne 409 (type …/invalid-transition). rowVersion périmé : 409 (type …/concurrency-conflict). Un changement de priorité recalcule les échéances SLA depuis la création ; la sortie de Pending décale les échéances de la durée passée en Pending. Chaque changement de statut, priorité, assignation ou catégorie ajoute un TicketEvent. Assigné : agent ou TenantAdmin actif de l'entreprise (422 sinon).",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mis à jour",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/tickets/{id}/comments": {
      "post": {
        "tags": [
          "tickets"
        ],
        "operationId": "addComment",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Requester (sur son ticket) ou Agent/TenantAdmin : ajoute un commentaire. isInternal=true réservé aux agents (403 pour un Requester). Ticket Closed : 409. Le premier commentaire public d'un agent renseigne firstResponseAt. Un commentaire d'un Requester sur un ticket Pending le repasse en Open (TicketEvent).",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comment"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/tickets/{id}/events": {
      "get": {
        "tags": [
          "tickets"
        ],
        "operationId": "listTicketEvents",
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Historique d'audit du ticket, du plus ancien au plus récent (Requester : le sien ; Agent : tous)",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketEvent"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Claims : sub, tid (absent pour SuperAdmin), role, email, name. Durée 15 min."
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "deskflow_refresh",
        "description": "HttpOnly, Secure, SameSite=Lax, 7 jours, rotation à chaque usage"
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "pageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Erreur RFC 7807",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "Provider": {
        "type": "string",
        "enum": [
          "google",
          "github"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "SuperAdmin",
          "TenantAdmin",
          "Agent",
          "Requester"
        ]
      },
      "DemoRole": {
        "type": "string",
        "enum": [
          "admin",
          "agent",
          "demandeur"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Présent pour 422 : champ -> messages"
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "required": [
          "accessToken",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "description": "secondes",
            "example": 900
          }
        }
      },
      "DemoLoginRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/DemoRole"
          }
        }
      },
      "Theme": {
        "type": "object",
        "required": [
          "colorPrimary",
          "colorSurface",
          "colorAccent"
        ],
        "properties": {
          "colorPrimary": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "example": "#7CC4EE"
          },
          "colorSurface": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "example": "#F4F7FA"
          },
          "colorAccent": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "example": "#D63A14"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "isDemo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "tenant": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/MeTenant"
              }
            ],
            "description": "Null pour le SuperAdmin"
          },
          "isDemo": {
            "type": "boolean",
            "description": "Vrai si Demo:Enabled : le front affiche la bannière « Mode démo, données fictives »"
          }
        }
      },
      "MeTenant": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "theme"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          }
        }
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "isActive",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateTenantRequest": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "adminEmail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 50
          },
          "adminEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "UpdateTenantRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "isActive",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "TenantAdmin",
              "Agent",
              "Requester"
            ]
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "Invitation": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "expiresAt",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Accepted",
              "Expired"
            ]
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "TenantAdmin",
              "Agent",
              "Requester"
            ]
          }
        }
      },
      "TenantPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tenant"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "UserPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "InvitationPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invitation"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "TicketStatus": {
        "type": "string",
        "enum": [
          "New",
          "Open",
          "Pending",
          "Resolved",
          "Closed"
        ]
      },
      "TicketPriority": {
        "type": "string",
        "enum": [
          "Low",
          "Normal",
          "High",
          "Urgent"
        ]
      },
      "UserRef": {
        "type": "object",
        "required": [
          "id",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "Category": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        }
      },
      "TicketSummary": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "status",
          "priority",
          "requester",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "description": "Séquentiel par entreprise"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TicketPriority"
          },
          "category": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "requester": {
            "$ref": "#/components/schemas/UserRef"
          },
          "assignee": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRef"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "responseDueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "resolutionDueAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "escalatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TicketPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketSummary"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "TicketDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TicketSummary"
          },
          {
            "type": "object",
            "required": [
              "description",
              "rowVersion",
              "comments"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "rowVersion": {
                "type": "string",
                "description": "Jeton opaque de concurrence optimiste, à renvoyer tel quel dans PATCH"
              },
              "firstResponseAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "resolvedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "comments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Comment"
                },
                "description": "Du plus ancien au plus récent"
              }
            }
          }
        ]
      },
      "CreateTicketRequest": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "priority": {
            "$ref": "#/components/schemas/TicketPriority"
          }
        },
        "description": "priority vaut Normal par défaut"
      },
      "UpdateTicketRequest": {
        "type": "object",
        "required": [
          "rowVersion"
        ],
        "properties": {
          "rowVersion": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TicketStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TicketPriority"
          },
          "assigneeId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "author",
          "body",
          "isInternal",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "author": {
            "$ref": "#/components/schemas/UserRef"
          },
          "body": {
            "type": "string"
          },
          "isInternal": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateCommentRequest": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "isInternal": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "TicketEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "Created",
              "StatusChanged",
              "PriorityChanged",
              "AssigneeChanged",
              "CategoryChanged"
            ]
          },
          "actor": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/UserRef"
              }
            ],
            "description": "Null pour un événement système"
          },
          "oldValue": {
            "type": "string",
            "nullable": true
          },
          "newValue": {
            "type": "string",
            "nullable": true,
            "description": "Statut/priorité en chaîne ; assignation et catégorie : nom affiché"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
